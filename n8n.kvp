Meta.DisplayName=n8n 3.x (Podman - AMP pilot)
Meta.Description=AMP-controlled native Podman launcher of the official n8n container; pilot requiring start/stop verification
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Formovo
Meta.URL=https://n8n.io
Meta.DisplayImageSource=none:
Meta.ConfigManifest=n8nconfig.json
Meta.MetaConfigManifest=n8nmetaconfig.json
Meta.ConfigRoot=n8n.kvp
Meta.MinAMPVersion=2.6.2.6
Meta.ContainerPolicy=Supported
Meta.ConfigVersion=4
Meta.AppConfigId=8b3ff599-69d5-491d-9ed1-ab2e547e2387
App.DisplayName=n8n
App.RootDir=./n8n/
App.BaseDirectory=./n8n/
App.ExecutableLinux=/usr/bin/podman
App.WorkingDir=
App.CommandLineArgs=run --rm --name formovo-n8n --pull=never -p 127.0.0.1:{{$ServerPort}}:5678 -v {{$FullBaseDir}}data:/home/node/.n8n:Z,U -e N8N_PORT=5678 -e N8N_LISTEN_ADDRESS=0.0.0.0 -e GENERIC_TIMEZONE=Europe/Warsaw -e TZ=Europe/Warsaw -e N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true docker.n8n.io/n8nio/n8n:3.0.0
App.LinuxCommandLineArgs=
App.AppSettings={}
App.EnvironmentVariables={}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=60
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=127.0.0.1
App.Ports=@IncludeJson[n8nports.json]
App.PrimaryApplicationPortRef=ServerPort
App.AdminPortRef=0
App.MaxUsers=0
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[n8nupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.Compatibility=LinuxBufferedConsole
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^.*(Editor is now accessible via:|n8n ready on|Version:).*$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.SuppressLogAtStart=False
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=0
