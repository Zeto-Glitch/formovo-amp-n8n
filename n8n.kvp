Meta.DisplayName=n8n (Formovo, native 2.x)
Meta.Description=n8n 2.x for AMP Generic on native Ubuntu/Debian (npm). Not compatible with n8n 3.x.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=Formovo local template
Meta.URL=https://n8n.io
Meta.ConfigManifest=n8nconfig.json
Meta.MetaConfigManifest=n8nmetaconfig.json
Meta.ConfigRoot=n8n.kvp
Meta.MinAMPVersion=2.6.2.6
Meta.ContainerPolicy=NotSupported
Meta.ExtraContainerPackages=[]
Meta.ConfigVersion=1
Meta.AppConfigId=b8fab40e-f4dd-46d1-9201-f3458da91bbf
App.DisplayName=n8n
App.RootDir=./n8n/
App.BaseDirectory=./n8n/
App.ExecutableLinux=/usr/bin/node
App.WorkingDir=
App.CommandLineArgs={{$FullBaseDir}}node_modules/n8n/bin/n8n start
App.LinuxCommandLineArgs=
App.AppSettings={}
App.EnvironmentVariables={"N8N_USER_FOLDER":"{{$FullBaseDir}}data","N8N_PORT":"{{$ServerPort}}","N8N_LISTEN_ADDRESS":"127.0.0.1","N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS":"true","GENERIC_TIMEZONE":"Europe/Warsaw","TZ":"Europe/Warsaw"}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=40
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=127.0.0.1
App.Ports=@IncludeJson[n8nports.json]
App.PrimaryApplicationPortRef=ServerPort
App.AdminPortRef=0
App.MaxUsers=0
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[n8nupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.Compatibility=LinuxBufferedConsole
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^.*(Editor is now accessible via:|n8n ready on|Version:).*$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.SuppressLogAtStart=False
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=2
